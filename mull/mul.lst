     1                                  ;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
     2                                  ;assemble and link with 
     3                                  ;set path
     4                                  ;path C:\emsamblador\Mingw64\bin
     5                                  ;assemble: -->> nasm -f win64 -o mul.o mul.asm -l mul.lst
     6                                  ;link:	   -->> gcc -o mul mul.o
     7                                  ;run:      -->> mul
     8                                  ;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
     9                                  ;-----------------------------------------
    10                                  
    11                                  ; programa de multiplicacion. 
    12                                  ;file: mul.asm
    13                                  
    14                                  extern printf, scanf		
    15                                  
    16                                  segment .data
    17 00000000 0A                      a	DB	10
    18 00000001 19                      b	DB	25
    19                                  
    20 00000002 0001                    c	DW	0x100		;256
    21 00000004 0020                    d	DW	0x2000		;8192
    22                                  		
    23                                  segment .bss
    24                                  ;block storage start
    25                                  ;aqui van las variables declaradas pero sin inicializar
    26                                  
    27                                  segment .text 
    28                                  global main 					
    29                                  main:
    30 00000000 4831C0                  	xor rax, rax			
    31                                  ;--------------MUL (Sin Signo)--------------------------------------
    32                                  ;multiplicación 8-bits
    33 00000003 B064                    	mov AL, 100	;AL= 0x64
    34 00000005 B219                    	mov DL, 25	;DL= 0x19
    35 00000007 F6E2                    	MUL DL		; producto: AX = AL*DL
    36                                  ;produce 100*25=2500=0x09C4 en el registro AX
    37                                  
    38                                  ;---------------IMUL (Con Signo)-------------------------------------
    39 00000009 B2FF                    	mov DL, 0xFF  ; DL = -1
    40 0000000B B0BE                    	mov AL, 0xBE  ; AL = -66
    41 0000000D F6EA                    	IMUL DL		 ; producto: AX = AL*DL
    42                                  ;produce (-1)*(-66)=66=0x0042 en el registro AX(resultado cabe en AL)
    43                                  ;si se usara MUL en vez de IMUL el resultado seria AX=0xBD42 (-> ERROR)
    44                                  
    45                                  ;-------------------------------------------------------
    46 0000000F 90                      	nop
    47 00000010 8A0425[00000000]        	mov al, [a]		; AL = 0x0A
    48 00000017 F62425[01000000]        	MUL byte[b]		; multiplicador en memoria [b] = 0x00FA
    49                                  
    50                                  ;--------------MUL (Sin Signo)--------------------------------------
    51                                  ;multiplicación 16-bits
    52 0000001E 668B0425[02000000]      	mov AX, [c]		;256
    53 00000026 668B0C25[04000000]      	mov CX, [d]		;8192
    54 0000002E 66F7E1                  	MUL CX			;DX:AX = AX*CX = 0x0020_0000 = 2097152
    55                                  	
    56                                  ;--------------MUL (Sin Signo)  --------------------------------------
    57                                  ;multiplicación 32-bits
    58 00000031 B856341200              	mov EAX, 0x123456
    59 00000036 B900001000              	mov ECX, 0x100000
    60 0000003B F7E1                    	MUL ECX			;EDX:EAX = EAX*ECX = 0X0000_0123 : 4560_5000
    61                                  
    62                                  ;--------------MUL (Sin Signo)  --------------------------------------
    63                                  ;multiplicación 64-bits
    64 0000003D 48B8AB896745230100-     	mov RAX, 0x123456789AB
    64 00000046 00                 
    65 00000047 48B900000000000100-     	mov RCX, 0x10000000000
    65 00000050 00                 
    66 00000051 48F7E1                  	MUL RCX			;RDX:RAX = RAX*RCX = 0x0000000000012345 : 6789AB0000000000
    67 00000054 C3                      ret
    68                                  
