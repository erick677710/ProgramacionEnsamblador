     2                                  ;assemble and link with 
     3                                  ;set path
     4                                  ;path C:\emsamblador\Mingw64\bin
     5                                  ;assemble: -->> nasm -f win64 -o pruba.o pruba.asm -l pruba.lst
     6                                  ;link:	   -->> gcc64 -o pruba pruba.o
     7                                  ;run:      -->> pruba
