    23                                  main:
    24                                  ;-------------------
    25                                  ;---division 32 bits
    26 00000000 668B0425[00000000]      	mov ax, [a]
    27 00000008 668B1425[02000000]      	mov dx, [a+2]
    28 00000010 668B1C25[04000000]      	mov bx, [b]
