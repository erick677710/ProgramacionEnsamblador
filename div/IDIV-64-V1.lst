    15 00000000 CCCCCC0C                a	DD	214_748_364		  ;0xCCC_CCCC
    16 00000004 3075                    b	DW	     30_000		  ;0x7530
    17                                  
    18 00000006 00204AA9D1010000        c	DQ  2_000_000_000_000 ;0x1D1A94A2000
